# EnviroGuard ML Backend - Environment Configuration
# Copy this file to .env and fill in actual values

# Server Configuration
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Model Paths
MODEL_PATH=./models
DATA_PATH=./data
OUTPUT_PATH=./outputs

# API Configuration
ENABLE_CORS=true
MAX_IMAGE_SIZE_MB=10

# Development
DEBUG=false
RELOAD=false
