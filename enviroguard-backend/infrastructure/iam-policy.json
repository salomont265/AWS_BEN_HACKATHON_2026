{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/enviroguard-stations",
        "arn:aws:dynamodb:*:*:table/enviroguard-stations/index/*",
        "arn:aws:dynamodb:*:*:table/enviroguard-sensor_readings",
        "arn:aws:dynamodb:*:*:table/enviroguard-sensor_readings/index/*",
        "arn:aws:dynamodb:*:*:table/enviroguard-hazard_reports",
        "arn:aws:dynamodb:*:*:table/enviroguard-hazard_reports/index/*",
        "arn:aws:dynamodb:*:*:table/enviroguard-users",
        "arn:aws:dynamodb:*:*:table/enviroguard-users/index/*",
        "arn:aws:dynamodb:*:*:table/enviroguard-posts",
        "arn:aws:dynamodb:*:*:table/enviroguard-posts/index/*",
        "arn:aws:dynamodb:*:*:table/enviroguard-alerts",
        "arn:aws:dynamodb:*:*:table/enviroguard-alerts/index/*"
      ]
    },
    {
      "Sid": "S3PhotoAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::enviroguard-photos",
        "arn:aws:s3:::enviroguard-photos/*",
        "arn:aws:s3:::enviroguard-avatars",
        "arn:aws:s3:::enviroguard-avatars/*"
      ]
    },
    {
      "Sid": "BedrockClaudeAccess",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-3-sonnet-20240229-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-3-haiku-20240307-v1:0",
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-*"
      ]
    },
    {
      "Sid": "CloudWatchLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/enviroguard-*"
    },
    {
      "Sid": "XRayAccess",
      "Effect": "Allow",
      "Action": [
        "xray:PutTraceSegments",
        "xray:PutTelemetryRecords"
      ],
      "Resource": "*"
    },
    {
      "Sid": "SecretsManagerAccess",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:*:*:secret:enviroguard/*"
      ]
    },
    {
      "Sid": "SESEmailAccess",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "noreply@enviroguard.app"
        }
      }
    },
    {
      "Sid": "SNSPushNotificationAccess",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:*:*:enviroguard-*"
    },
    {
      "Sid": "EC2NetworkAccess",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "ec2:Vpc": "arn:aws:ec2:*:*:vpc/*"
        }
      }
    }
  ]
}
