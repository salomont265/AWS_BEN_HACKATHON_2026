# EnviroGuard Backend Environment Variables
# Copy this file to .env and fill in the values

# ===== AWS CONFIGURATION =====
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ===== API GATEWAY =====
API_GATEWAY_ID=your-api-gateway-id
API_GATEWAY_STAGE=prod
API_BASE_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# ===== DYNAMODB TABLES =====
DYNAMODB_TABLE_STATIONS=enviroguard-stations
DYNAMODB_TABLE_READINGS=enviroguard-sensor_readings
DYNAMODB_TABLE_REPORTS=enviroguard-hazard_reports
DYNAMODB_TABLE_USERS=enviroguard-users
DYNAMODB_TABLE_POSTS=enviroguard-posts
DYNAMODB_TABLE_ALERTS=enviroguard-alerts

# ===== S3 STORAGE =====
S3_BUCKET_PHOTOS=enviroguard-photos
S3_BUCKET_AVATARS=enviroguard-avatars
S3_REGION=us-east-1

# ===== ML BACKEND =====
# EC2 instance running enviroguard-ml Prophet models
ML_API_URL=http://10.0.1.50:8000
ML_API_TIMEOUT=10
ML_API_RETRIES=3

# ===== BEDROCK (Claude AI) =====
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.7

# ===== AUTHENTICATION =====
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-client-id
JWT_SECRET=your-jwt-secret-key-change-in-production

# ===== RATE LIMITING =====
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_ML=50
RATE_LIMIT_CLAUDE=20

# ===== CORS =====
CORS_ALLOWED_ORIGINS=https://enviroguard.app,http://localhost:*,exp://*
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With

# ===== LOGGING =====
LOG_LEVEL=INFO
CLOUDWATCH_LOG_GROUP=/aws/lambda/enviroguard
CLOUDWATCH_LOG_RETENTION_DAYS=30

# ===== MONITORING =====
ENABLE_XRAY=true
ENABLE_METRICS=true

# ===== SECRETS (Use AWS Secrets Manager in production) =====
# These should NOT be in .env in production - use Secrets Manager
DB_ENCRYPTION_KEY=change-me-use-secrets-manager
API_SECRET_KEY=change-me-use-secrets-manager

# ===== OPTIONAL: EMAIL NOTIFICATIONS =====
SES_FROM_EMAIL=noreply@enviroguard.app
SES_REGION=us-east-1

# ===== OPTIONAL: MOBILE PUSH NOTIFICATIONS =====
SNS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-east-1:123456789012:app/GCM/EnviroGuard
