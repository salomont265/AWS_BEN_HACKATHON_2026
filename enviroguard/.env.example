# EnviroGuard Environment Variables
# Copy this file to .env and fill in your values

# ===== API CONFIGURATION =====
# FAKE: Points to localhost for development
# REAL: Set to your API Gateway URL when deploying backend
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_API_TIMEOUT=10000

# ===== CLAUDE API =====
# WORKS NOW: Get your API key from https://console.anthropic.com/
# Required for: Photo analysis (Tab 3) and Letter generation (Tab 4)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ===== FEATURE FLAGS =====
# Use fake data (no backend needed)
# FAKE: true = uses local JSON files
# REAL: false = makes API calls to API_BASE_URL
EXPO_PUBLIC_ENABLE_FAKE_DATA=true

# Kiosk mode for public displays
# Set to 'true' for tablet kiosk builds (hides Profile tab, skips auth)
EXPO_PUBLIC_KIOSK_MODE=false

# Enable analytics tracking (future)
EXPO_PUBLIC_ENABLE_ANALYTICS=false

# Enable push notifications (future)
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true

# ===== MAP CONFIGURATION =====
# FUTURE: Mapbox token for real map display
# Get from: https://account.mapbox.com/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.ey...YOUR_TOKEN_HERE

# ===== AWS CONFIGURATION =====
# FUTURE: AWS credentials for direct SDK calls (if needed)
# Recommend: Use API Gateway instead of direct AWS calls from app
# EXPO_PUBLIC_AWS_REGION=us-east-1
# EXPO_PUBLIC_DYNAMODB_TABLE_PREFIX=enviroguard-dev-

# ===== DEVELOPMENT =====
# Debug logging
EXPO_PUBLIC_DEBUG_MODE=true
